# ==============================================================================
# MedLens — AI-Powered Clinical Information Intelligence
# Environment Configuration Template
# NOTE: Never commit production credentials or actual .env files to source control!
# ==============================================================================

# Core Service Placeholders
DATABASE_URL=postgresql+psycopg://medlens_user:medlens_password@localhost:5432/medlens_db
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
AI_API_KEY=your-gemini-or-openai-api-key-here
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Application Environment (development, staging, production)
APP_ENV=development
APP_NAME="MedLens — AI-Powered Clinical Information Intelligence"
APP_VERSION=0.1.0
DEBUG=true

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Security & CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# Offline Development Fallback
AUTO_FALLBACK_SQLITE=true
SQLITE_FALLBACK_URL=sqlite:///../database/medlens.db

# File Storage & Uploads
UPLOAD_DIR=../uploads
MAX_UPLOAD_SIZE_MB=25
ALLOWED_FILE_EXTENSIONS=[".pdf",".txt",".json",".xml",".csv",".png",".jpg",".jpeg"]

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1
